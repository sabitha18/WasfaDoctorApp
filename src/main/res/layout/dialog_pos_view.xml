<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="20dp"
    android:background="@color/white"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:layout_gravity="center_vertical"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/roboto_bold"
        android:text="Sku Grouping"
        android:textColor="#424546"
        android:textSize="16sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="15dp"
        android:background="#7D7C7C" />

    <TextView
        android:layout_marginTop="10dp"
        android:id="@+id/txt_item_least_price_sold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/roboto_bold"
        android:text="PickUp Point Stock"
        android:textColor="#424546"
        android:textSize="14sp" />
    <TextView
        android:layout_marginTop="10dp"
        android:id="@+id/txt_last_sold_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/roboto_bold"
        android:text="Last Sold Price"
        android:textColor="#424546"
        android:textSize="14sp" />
    <TextView
        android:layout_marginTop="10dp"
        android:id="@+id/txt_seller"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/roboto_bold"
        android:text="Last Sold Price"
        android:textColor="#424546"
        android:textSize="14sp" />
    <LinearLayout
        android:layout_marginTop="10dp"
        android:layout_gravity="center_vertical"
        android:gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView

            android:id="@+id/txt_date_of_sale"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_bold"
            android:text="Last Sold Price"
            android:textColor="#424546"
            android:textSize="14sp" />
        <com.google.android.material.card.MaterialCardView
            android:layout_width="80dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="5dp"
            app:cardBackgroundColor="#0abb75"
            app:cardCornerRadius="8dp"
            android:layout_height="30dp">
            <TextView
                android:layout_gravity="center"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_bold"
                android:text="orders"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="20dp"
        android:background="#7D7C7C" />
    <TextView
        android:layout_marginTop="10dp"
        android:layout_gravity="center_vertical"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/roboto_bold"
        android:text="APIX SKU Grouping"
        android:textColor="#424546"
        android:textSize="16sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="#000" />

    <TextView
        android:layout_marginTop="10dp"
        android:id="@+id/txt_purchase_form"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/roboto_bold"
        android:text="PickUp Point Stock"
        android:textColor="#424546"
        android:textSize="14sp" />

    <TextView
        android:layout_marginTop="10dp"
        android:id="@+id/txt_less_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/roboto_bold"
        android:text="Last Sold Price"
        android:textColor="#424546"
        android:textSize="14sp" />
    <TextView
        android:layout_marginTop="10dp"
        android:id="@+id/txt_seller_least_price_sold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/roboto_bold"
        android:text="Last Sold Price"
        android:textColor="#424546"
        android:textSize="14sp" />


    <com.google.android.material.card.MaterialCardView
        android:layout_width="100dp"
        android:layout_marginTop="20dp"
        app:strokeWidth="0dp"
        android:id="@+id/card_close"
        app:cardCornerRadius="5dp"
        app:cardBackgroundColor="#8f97ab"
        android:layout_gravity="center|end"
        android:layout_height="35dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_regular"
            android:text="Close"
            android:layout_gravity="center"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="16sp" />
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
